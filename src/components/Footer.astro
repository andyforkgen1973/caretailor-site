---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-row">
      <div class="footer-brand">
        <a href="/" aria-label="CareTailor home"><img src="/images/logo-dark.svg" alt="CareTailor" width="293" height="46" loading="lazy" /></a>
        <p class="copyright">Copyright CareTailor © {year}. All Rights Reserved.</p>
      </div>
      <div class="footer-links">
        <div class="socials">
          {site.socials.map((s) => (
            <a href={s.url} target="_blank" rel="noopener" aria-label={s.name}>
              <img src={s.icon} alt="" width="40" height="40" loading="lazy" />
            </a>
          ))}
        </div>
        <div class="legal-links">
          <a href="/terms-and-conditions">Terms and Conditions</a><span class="sep">|</span><a href="/privacy-policy">Privacy Policy</a>
        </div>
      </div>
    </div>
  </div>
</footer>
